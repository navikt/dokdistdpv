<configuration xmlns="urn:activemq" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			   xsi:schemaLocation="urn:activemq /schema/artemis-configuration.xsd">
	<core xmlns="urn:activemq:core">
		<acceptors>
			<acceptor name="invm">vm://0</acceptor>
		</acceptors>
		<security-enabled>false</security-enabled>
		<persistence-enabled>false</persistence-enabled>
		<address-settings>
			<address-setting match="qdist016">
				<dead-letter-address>qdist016Bq</dead-letter-address>
				<expiry-address>qdist016Bq</expiry-address>
				<max-delivery-attempts>1</max-delivery-attempts>
			</address-setting>
		</address-settings>

		<addresses>
			<address name="qdist016">
				<anycast>
					<queue name="qdist016"/>
				</anycast>
			</address>
			<address name="qdist016_funk_feil">
				<anycast>
					<queue name="qdist016_funk_feil"/>
				</anycast>
			</address>
			<address name="qdist016_boq">
				<anycast>
					<queue name="qdist016_boq"/>
				</anycast>
			</address>
			<address name="qdist009">
				<anycast>
					<queue name="qdist009"/>
				</anycast>
			</address>
		</addresses>
	</core>
</configuration>